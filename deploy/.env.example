# Copy to deploy/.env (next to docker-compose.yml) and adjust as needed.

# Host ports exposed by docker compose.
AVPLAYER_AGENT_PORT=50061
AVPLAYER_MEDIA_SERVER_PORT=50062
AVPLAYER_WEB_GATEWAY_PORT=50065
AVPLAYER_WEB_PORT=8080
AVPLAYER_OLLAMA_PORT=11434

# Shared storage for uploaded media, transcripts and exported clips.
# Relative paths are resolved from the deploy/ directory.
AVPLAYER_STORAGE_DIR=../storage
AVPLAYER_CONFIG_DIR=../config
AVPLAYER_RESOURCE_DIR=../resource

# cloud (Doubao/Ark) or local (Ollama + faster-whisper).
AVPLAYER_AI_PROVIDER=cloud

# Reachable from the agent container. The optional "local" compose profile
# starts Ollama under this name; override for an external Ollama host.
AVPLAYER_OLLAMA_HOST=http://ollama:11434

# Comma-separated STUN/TURN URLs used by both media_server and the browser.
# TURN credentials are not supported by this env var yet; use a URL-only TURN
# for now or extend settings.py/local MediaSession.cpp together.
AVPLAYER_ICE_SERVERS=stun:stun.l.google.com:19302

# Optional caching/persistence stack started by compose.
AVPLAYER_REDIS_PORT=6379
AVPLAYER_MYSQL_PORT=3306
AVPLAYER_MYSQL_PASSWORD=avplayer
AVPLAYER_MYSQL_ROOT_PASSWORD=avplayer-root
# Leave empty to run without MySQL (the agent falls back to disk storage).
# AVPLAYER_MYSQL_DSN=mysql://avplayer:avplayer@mysql:3306/avplayer

# Optional ZooKeeper discovery (blank preserves a single static media target).
AVPLAYER_ZK_HOSTS=
AVPLAYER_ZK_MEDIA_PATH=/avplayer/media
# Media endpoint reachable by gateway; required when ZooKeeper is enabled.
AVPLAYER_MEDIA_ADVERTISE=media:50062


# Agent tools require the self-hosted C++ MCP server; configure it to reach gateway:50066.
AVPLAYER_MCP_URL=http://host.docker.internal:8081/jsonrpc
