        <mxCell id="ui" value="UI 层&#xa;MainWindow · PlayerWidget · ControllerWidget&#xa;AI 助手侧栏 · Agent 工作台" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="client"><mxGeometry x="30" y="60" width="620" height="100" as="geometry"/></mxCell>
